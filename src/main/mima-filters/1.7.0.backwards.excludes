# Deliberate binary breaks in 1.8.0, relative to 1.7.0. See the release note in README.md.
#
# core.Zero and core.Monoid were published type classes that Visitor itself never consumed:
# neither appeared in any signature in the public API, and the only references to them anywhere
# were their own declarations and their given instances for Int/Long/Float/Double. Visitor
# defined them and never asked a caller for one. They are removed rather than migrated to
# cats.kernel.Monoid, which would have put cats-kernel at the base of the Phasmid stack to supply
# something nothing here uses. A caller who imported `given Monoid[Double]` (or Int/Long/Float)
# from core should depend on cats-kernel, which supplies these through the implicit scope with no
# import at all. See https://github.com/rchillyard/Visitor/issues/21
#
# Under PVP, 1.7.0 -> 1.8.0 is a major bump, so these breaks are permitted. This file retires
# itself: once previousRelease moves past 1.7.0, MiMa stops consulting it.
#
# The exact filter lines below are MiMa's own suggestions from the failing run, not hand-written.

ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Zero")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Monoid")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.Behaviours#package.given_Zero_A(com.phasmidsoftware.visitor.core.Monoid)com.phasmidsoftware.visitor.core.Behaviours#package#given_Zero_A")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Monoid_Double$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Monoid_Float$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Monoid_Int$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Monoid_Long$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Zero_A")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Zero_Double$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Zero_Float$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Zero_Int$")
ProblemFilters.exclude[MissingClassProblem]("com.phasmidsoftware.visitor.core.Behaviours$package$given_Zero_Long$")

# ---------------------------------------------------------------------------
# Generalising Visitor over its journal's element type (1.8.0).
#
# `Visitor[V, R, J <: Appendable[Mapped[V, R]]]` becomes `Visitor[V, E, J <: Appendable[E]]`,
# where E is what the journal holds. This is what lets SimpleVisitor — which records bare nodes
# into an Appendable[V] and needs no Evaluable — be an ordinary Visitor that every Traversal
# entry point accepts. Appendable is invariant in its element type (it appears both as append's
# parameter and in its result), so Appendable[V] is not an Appendable[(V, Option[R])]; without E
# the simple case could only be expressed by an adapter that discarded half of every entry.
#
# Consequently `visit` loses its `using Evaluable` clause — a JournaledVisitor now binds its
# Evaluable once, when built — and all seven Traversal entry points lose that implicit
# parameter. Source impact on callers is small: in Visitor's own 183-test suite only two sites
# needed changing.
#
# The lines below are MiMa's own suggestions from the failing run, not hand-written.
# ---------------------------------------------------------------------------

ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.<init>$default$2()scala.None#")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.apply(com.phasmidsoftware.visitor.core.Appendable,scala.Option)com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.copy(com.phasmidsoftware.visitor.core.Appendable,scala.Option)com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.this(com.phasmidsoftware.visitor.core.Appendable,scala.Option)Unit")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.visit(java.lang.Object,com.phasmidsoftware.visitor.core.Evaluable)com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.withListJournal()com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.withListJournalAndCameFrom()com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.withQueueJournal()com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.JournaledVisitor.withQueueJournalAndCameFrom()com.phasmidsoftware.visitor.core.JournaledVisitor")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.Traversal.bestFirst$default$8(java.lang.Object,com.phasmidsoftware.visitor.core.Visitor,scala.Function1)com.phasmidsoftware.visitor.core.Tracer#silent")
ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.Traversal.bestFirst(java.lang.Object,com.phasmidsoftware.visitor.core.Visitor,scala.Function1,scala.math.Ordering,com.phasmidsoftware.visitor.core.Neighbours,com.phasmidsoftware.visitor.core.Evaluable,com.phasmidsoftware.visitor.core.VisitedSet,com.phasmidsoftware.visitor.core.Tracer)com.phasmidsoftware.visitor.core.Visitor")
