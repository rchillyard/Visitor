ProblemFilters.exclude[DirectMissingMethodProblem]("com.phasmidsoftware.visitor.core.Traversal.bestFirstWeighted$default$10(java.lang.Object,com.phasmidsoftware.visitor.core.Visitor,scala.Function1)com.phasmidsoftware.visitor.core.Tracer#silent")
